{
  "name": "hanlearn-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"firebase emulators:start --import=./emulator-data\" \"npm run dev:client\"",
    "dev:client": "npm --prefix web-client run dev",
    "emulators": "firebase emulators:start --export-on-exit=./emulator-data --import=./emulator-data",
    "build": "npm --prefix web-client run build:all",
    "deploy": "npm run build && firebase deploy --only hosting",
    "prepare": "husky"
  },
  "lint-staged": {
    "web-client/src/**/*.{ts,tsx}": [
      "eslint --config web-client/eslint.config.mjs",
      "prettier --config web-client/.prettierrc --write"
    ],
    "web-client/src/**/*.{css,json}": [
      "prettier --config web-client/.prettierrc --write"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2"
  }
}
