{
  "name": "hanlearn-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"sh -c 'firebase emulators:start $([ -d ./emulator-data ] && echo --import=./emulator-data)'\" \"npm run dev:client\"",
    "dev:client": "npm --prefix web-client run dev",
    "emulators": "sh -c 'firebase emulators:start --export-on-exit=./emulator-data $([ -d ./emulator-data ] && echo --import=./emulator-data)'",
    "build:dict": "node migration/build-dictionary.js",
    "build": "npm run build:dict && npm --prefix web-client run build",
    "deploy": "npm run build && firebase deploy --only hosting",
    "prepare": "husky"
  },
  "lint-staged": {
    "web-client/src/**/*.{ts,tsx}": [
      "npx --prefix web-client eslint --config web-client/eslint.config.mjs",
      "npx --prefix web-client prettier --config web-client/.prettierrc --write"
    ],
    "web-client/src/**/*.{css,json}": [
      "npx --prefix web-client prettier --config web-client/.prettierrc --write"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2"
  }
}
