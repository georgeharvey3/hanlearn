rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Helpers for the per-direction scheduling map on userWords ───────────
    // A word carries one scheduling record per direction. The five direction
    // keys are fixed. See docs/adr/0002-direction-level-scheduling.md.
    function directionKeys() {
      return ['MC', 'MP', 'PM', 'PC', 'CM'];
    }

    // The bank and the due date are always present. The memory state that FSRS
    // reads is optional, because a direction that no session has asked since
    // the release does not carry it. `interval` and `ease` are the fields of
    // the calculations that FSRS replaced, and a document keeps them until its
    // next review. See docs/adr/0009-fsrs.md. `lapses` counts the failed
    // retrievals of the leech rule, and it appears only once a direction has
    // collected one. See docs/adr/0010-partial-demotion-and-leeches.md.
    function validDirection(d) {
      return d.keys().hasOnly([
          'bank', 'dueDate', 'stability', 'difficulty',
          'interval', 'ease', 'lastReview', 'toneErrors', 'lapses'
        ])
        && d.bank is int
        && d.bank >= 1
        && d.bank <= 5
        && d.dueDate is timestamp
        && (!('stability' in d.keys()) || (d.stability is number && d.stability >= 0))
        && (!('difficulty' in d.keys()) || (d.difficulty is number && d.difficulty >= 1 && d.difficulty <= 10))
        && (!('interval' in d.keys()) || (d.interval is int && d.interval >= 0 && d.interval <= 365))
        && (!('lastReview' in d.keys()) || d.lastReview is timestamp)
        && (!('toneErrors' in d.keys()) || (d.toneErrors is int && d.toneErrors >= 0))
        && (!('lapses' in d.keys()) || (d.lapses is int && d.lapses >= 0));
    }

    function validDirections(dirs) {
      return dirs is map
        && dirs.keys().hasOnly(directionKeys())
        && dirs.keys().hasAll(directionKeys())
        && validDirection(dirs.MC)
        && validDirection(dirs.MP)
        && validDirection(dirs.PM)
        && validDirection(dirs.PC)
        && validDirection(dirs.CM);
    }

    // The map is optional so that a client running the previous release, which
    // writes only the top-level bank and dueDate, is not rejected during the
    // rollout. When it is written, it must be complete and in range.
    function directionsOk(data) {
      return !('directions' in data.keys()) || validDirections(data.directions);
    }

    // The lists that hold a word. Every word is in at least one list, so the
    // array is never empty. Rules cannot test each item, so the client keeps
    // the item type. A document the backfill has not reached holds `listId`
    // in its place, so the field is checked only when it is present.
    function listIdsOk(data) {
      return !('listIds' in data.keys())
        || (data.listIds is list && data.listIds.size() >= 1);
    }

    // Words collection - read-only for authenticated users
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only via Admin SDK
    }

    // Users can only access their own data
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'username', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 50;

      // WordLists subcollection
      match /wordLists/{listId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // UserWords subcollection
      match /userWords/{wordId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['wordData', 'bank', 'dueDate'])
          && directionsOk(request.resource.data)
          && listIdsOk(request.resource.data)
          && request.resource.data.bank is int
          && request.resource.data.bank >= 1
          && request.resource.data.bank <= 5
          && request.resource.data.wordData.simp is string
          && request.resource.data.wordData.simp.size() <= 50
          && request.resource.data.wordData.trad is string
          && request.resource.data.wordData.trad.size() <= 50
          && request.resource.data.wordData.pinyin is string
          && request.resource.data.wordData.pinyin.size() <= 200
          && request.resource.data.wordData.meaning is string
          && request.resource.data.wordData.meaning.size() <= 500;
        allow update: if request.auth != null && request.auth.uid == userId
          && (!('bank' in request.resource.data.diff(resource.data).affectedKeys())
              || (request.resource.data.bank is int
                  && request.resource.data.bank >= 1
                  && request.resource.data.bank <= 5))
          && (!('amendedMeaning' in request.resource.data.diff(resource.data).affectedKeys())
              || (request.resource.data.amendedMeaning is string
                  && request.resource.data.amendedMeaning.size() <= 500))
          && (!('directions' in request.resource.data.diff(resource.data).affectedKeys())
              || validDirections(request.resource.data.directions))
          && (!('listIds' in request.resource.data.diff(resource.data).affectedKeys())
              || listIdsOk(request.resource.data));
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // ReviewStats subcollection: one rollup document per day, holding the
      // counters the retention metrics read. Every field is a counter that only
      // ever grows, so the rules check the shape and the sign rather than the
      // value. See docs/adr/0013-retention-metrics.md.
      function validTally(t) {
        return t.keys().hasOnly([
            'attempts', 'reviews', 'reviewPasses', 'promoted', 'held', 'demoted'
          ])
          && (!('attempts' in t.keys()) || (t.attempts is int && t.attempts >= 0))
          && (!('reviews' in t.keys()) || (t.reviews is int && t.reviews >= 0))
          && (!('reviewPasses' in t.keys()) || (t.reviewPasses is int && t.reviewPasses >= 0))
          && (!('promoted' in t.keys()) || (t.promoted is int && t.promoted >= 0))
          && (!('held' in t.keys()) || (t.held is int && t.held >= 0))
          && (!('demoted' in t.keys()) || (t.demoted is int && t.demoted >= 0));
      }

      // A session writes only the directions it asked, so every key is optional
      // and each one present must be a valid tally.
      function validTallies(dirs) {
        return dirs is map
          && dirs.keys().hasOnly(directionKeys())
          && (!('MC' in dirs.keys()) || validTally(dirs.MC))
          && (!('MP' in dirs.keys()) || validTally(dirs.MP))
          && (!('PM' in dirs.keys()) || validTally(dirs.PM))
          && (!('PC' in dirs.keys()) || validTally(dirs.PC))
          && (!('CM' in dirs.keys()) || validTally(dirs.CM));
      }

      function validLevelCount(levels, level) {
        return !(level in levels.keys())
          || (levels[level] is int && levels[level] >= 0);
      }

      // The words at each level when a session ended: the Dashboard's
      // progress chart reads one per week.
      function validLevels(levels) {
        return levels is map
          && levels.keys().hasOnly(['1', '2', '3', '4', '5'])
          && validLevelCount(levels, '1')
          && validLevelCount(levels, '2')
          && validLevelCount(levels, '3')
          && validLevelCount(levels, '4')
          && validLevelCount(levels, '5');
      }

      match /reviewStats/{dateId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['date', 'updatedAt', 'directions', 'levels'])
          && request.resource.data.date is string
          && request.resource.data.date == dateId
          && request.resource.data.updatedAt is timestamp
          && (!('directions' in request.resource.data.keys())
              || validTallies(request.resource.data.directions))
          && (!('levels' in request.resource.data.keys())
              || validLevels(request.resource.data.levels));
      }

      // ReviewLog subcollection: one document per saved session, with one entry
      // per graded question. See issue #397. `finishTest` writes it in the
      // batch that reschedules the words, so a rejection here fails the whole
      // session: each case of the rules tests writes the shape the app writes.
      //
      // The rules check the top level only. Rules have no loop, so each entry
      // needs its own unrolled check, and a session of 50 questions passes the
      // limit of 1000 expressions for one request: in the emulator, even
      // `is map` on each entry stops at 30 entries. The log is the owner's own
      // data and nothing else reads it, so a bad entry harms only the export.
      match /reviewLog/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['version', 'date', 'reviewedAt', 'scheduler', 'reviews'])
          && request.resource.data.keys().hasAll(['version', 'date', 'reviewedAt', 'scheduler', 'reviews'])
          && request.resource.data.version == 1
          && request.resource.data.date is string
          && request.resource.data.reviewedAt is timestamp
          && request.resource.data.scheduler is string
          && request.resource.data.reviews is list
          && request.resource.data.reviews.size() >= 1;
        // Write-once: no client changes or deletes the history after the session.
        allow update, delete: if false;
      }

      // TestCompletions subcollection (streak tracking)
      match /testCompletions/{dateId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['completedAt', 'testsCount'])
          && request.resource.data.testsCount is int
          && request.resource.data.testsCount >= 1;
      }
    }

    // Chengyus - read-only for authenticated users
    match /chengyus/{chengyuId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only via Admin SDK
    }

    // Daily chengyu cache - written by cloud function, read-only for clients
    match /dailyChengyu/{dateKey} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud functions use Admin SDK
    }

    // Rate limit counters - only accessible by Cloud Functions (Admin SDK)
    match /rateLimits/{userId}/{document=**} {
      allow read, write: if false;
    }

    // Sentence cache - shared public data generated by Firebase AI Logic.
    // Reads are public so unauthenticated demo users can benefit from the cache.
    // Writes require auth to prevent abuse.
    match /sentenceCache/{word} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.keys().hasAll(['sentences', 'generatedAt'])
        && request.resource.data.sentences is list
        && request.resource.data.sentences.size() <= 10;
    }

    // Chengyu sentence cache - AI-generated example sentences for daily chengyus.
    // Public read so all users see the same cached sentence.
    // Auth write to prevent abuse.
    match /chengyuSentences/{chengyu} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.keys().hasAll(['sentence', 'generatedAt'])
        && request.resource.data.sentence.chinese is string
        && request.resource.data.sentence.chinese.size() <= 200
        && request.resource.data.sentence.pinyin is string
        && request.resource.data.sentence.pinyin.size() <= 500
        && request.resource.data.sentence.english is string
        && request.resource.data.sentence.english.size() <= 500;
    }
  }
}
