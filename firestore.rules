rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Words collection - read-only for authenticated users
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only via Admin SDK
    }

    // Users can only access their own data
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'username', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 50;

      // UserWords subcollection
      match /userWords/{wordId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['wordData', 'bank', 'dueDate'])
          && request.resource.data.bank is int
          && request.resource.data.bank >= 1
          && request.resource.data.bank <= 5
          && request.resource.data.wordData.simp is string
          && request.resource.data.wordData.simp.size() <= 50
          && request.resource.data.wordData.trad is string
          && request.resource.data.wordData.trad.size() <= 50
          && request.resource.data.wordData.pinyin is string
          && request.resource.data.wordData.pinyin.size() <= 200
          && request.resource.data.wordData.meaning is string
          && request.resource.data.wordData.meaning.size() <= 500;
        allow update: if request.auth != null && request.auth.uid == userId
          && (!('bank' in request.resource.data.diff(resource.data).affectedKeys())
              || (request.resource.data.bank is int
                  && request.resource.data.bank >= 1
                  && request.resource.data.bank <= 5))
          && (!('amendedMeaning' in request.resource.data.diff(resource.data).affectedKeys())
              || (request.resource.data.amendedMeaning is string
                  && request.resource.data.amendedMeaning.size() <= 500));
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // TestCompletions subcollection (streak tracking)
      match /testCompletions/{dateId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['completedAt', 'testsCount'])
          && request.resource.data.testsCount is int
          && request.resource.data.testsCount >= 1;
      }
    }

    // Chengyus - read-only for authenticated users
    match /chengyus/{chengyuId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only via Admin SDK
    }

    // Daily chengyu cache - written by cloud function, read-only for clients
    match /dailyChengyu/{dateKey} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud functions use Admin SDK
    }

    // Rate limit counters - only accessible by Cloud Functions (Admin SDK)
    match /rateLimits/{userId}/{document=**} {
      allow read, write: if false;
    }

    // Sentence cache - shared public data generated by Firebase AI Logic.
    // Reads are public so unauthenticated demo users can benefit from the cache.
    // Writes require auth to prevent abuse.
    match /sentenceCache/{word} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.keys().hasAll(['sentence', 'timestamp'])
        && request.resource.data.sentence is string
        && request.resource.data.sentence.size() <= 1000;
    }
  }
}
